# ==========================================================
# RAG From Scratch Course — Provider Configuration
# ==========================================================
# Copy this file to `.env` if you want to switch providers.
# By default (`RAG_PROVIDER=local`), the ENTIRE course runs
# completely free and offline with zero API keys required!
#
# Supported values for RAG_PROVIDER:
#   local      (Default: offline deterministic grounded model + local embeddings)
#   ollama     (Local Ollama chat model + local sentence-transformers embeddings)
#   openai     (OpenAI chat + OpenAI embeddings)
#   anthropic  (Anthropic Claude chat + OpenAI or local embeddings)

RAG_PROVIDER=local

# --- Optional: Hosted Providers ---
# OPENAI_API_KEY=sk-replace-with-your-real-key
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ANTHROPIC_API_KEY=sk-ant-replace-with-your-real-key
# ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-latest

# --- Optional: Ollama Local Server ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.2

# --- Optional: Local Sentence-Transformers Embedding Model ---
# LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

