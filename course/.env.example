# ==============================================================================
# RAG From Scratch Course — Provider Configuration
# ==============================================================================
# Copy this file to `.env` inside `course/` (or repository root).
#
# Supported RAG_PROVIDER values:
#   openai        Hosted OpenAI chat + OpenAI embeddings (requires OPENAI_API_KEY)
#   anthropic     Hosted Anthropic chat + local sentence-transformers embeddings
#   ollama        100% free local Ollama chat + local sentence-transformers/Ollama embeddings
#   offline_demo  Deterministic code-path smoke mode for chat when no LLM daemon/API key
#                 is running (uses REAL local sentence-transformers neural embeddings!)

RAG_PROVIDER=ollama

# --- Hosted: OpenAI ---
# OPENAI_API_KEY=sk-replace-with-your-key
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Hosted: Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
# ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-latest

# --- Local: Ollama (Free) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.2

# --- Local Embeddings & Reranker (HuggingFace sentence-transformers) ---
# LOCAL_EMBED_MODEL=all-MiniLM-L6-v2
# LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Optional: LangSmith Observability ---
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=

